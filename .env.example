# You can use ANY LLM Provider via litellm
# Examples: 
# - OpenAI: LLM_MODEL=gpt-4o, LLM_API_KEY=sk-...
# - Anthropic: LLM_MODEL=claude-3-5-sonnet-20240620, LLM_API_KEY=sk-ant-...
# - Local (Ollama): LLM_MODEL=ollama/llama3, LLM_API_BASE=http://localhost:11434

LLM_MODEL=gpt-4o
LLM_API_KEY=your_api_key_here
LLM_API_BASE=
